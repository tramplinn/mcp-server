# Local development: copy to .env. Production uses k8s ConfigMaps and Secrets.
TRAMPLIN_API_URL=http://localhost:8000/api/v1
# Нужен только для локального stdio; HTTP использует browser OAuth.
TRAMPLIN_API_TOKEN=
TRAMPLIN_API_TIMEOUT=30

TRAMPLIN_MCP_TRANSPORT=stdio
TRAMPLIN_MCP_HOST=127.0.0.1
TRAMPLIN_MCP_PORT=8001
TRAMPLIN_MCP_PUBLIC_URL=http://localhost:8001
TRAMPLIN_OAUTH_BASE_URL=http://localhost:8000/api/v1
TRAMPLIN_OAUTH_CLIENT_ID=tramplin-fastmcp
TRAMPLIN_OAUTH_CLIENT_SECRET=
# openssl rand -hex 32
TRAMPLIN_MCP_JWT_SIGNING_KEY=

# Required for HTTP OAuth. Infra owns a separate PostgreSQL database and role.
TRAMPLIN_OAUTH_DATABASE_URL=postgresql://tramplin_mcp:replace-with-hex-password@localhost:5432/tramplin_mcp
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRAMPLIN_MCP_STORAGE_ENCRYPTION_KEY=
